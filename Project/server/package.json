{
  "name": "intellisearch-server",
  "version": "1.0.0",
  "description": "High-Performance In-Memory Trie Autocomplete Engine Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": ["trie", "autocomplete", "priority-queue", "heap", "mongodb", "express"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.10.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "rootDir": "..",
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/server/node_modules"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
