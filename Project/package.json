{
  "name": "intellisearch",
  "version": "1.0.0",
  "description": "IntelliSearch — High-Performance Autocomplete Engine using In-Memory Trie & Min-Heap Top-K Ranking",
  "scripts": {
    "setup": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "node scripts/seed.js",
    "benchmark": "node benchmark/benchmark.js",
    "concurrency": "node benchmark/concurrency.js",
    "test": "cd server && npm test",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mongoose": "^8.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
